# Leave blank to use the same origin (Vite proxy / Firebase Hosting rewrite).
# Or set the deployed HTTPS function base URL, without /v1:
# VITE_API_URL=https://asia-south1-YOUR_PROJECT_ID.cloudfunctions.net/api
VITE_API_URL=

# Firebase web app settings from Firebase Console > Project settings.
# These are public client settings; never put service-account or SMS secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional local Firebase Auth emulator (unset for real accounts).
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Vite dev proxy target when VITE_API_URL is blank. Replace YOUR_PROJECT_ID.
API_PROXY_TARGET=http://127.0.0.1:5002/YOUR_PROJECT_ID/asia-south1/api
