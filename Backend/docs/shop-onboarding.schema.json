{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic shop onboarding request",
  "description": "Request body for POST /v1/owner/car-washes/onboarding and PUT /v1/owner/car-washes/{carWashId}/onboarding. Runtime additionally checks unique nonpast dates, nonoverlapping slots, selected service categories, and future capacity that fits every active service.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "contactPhone": {
      "type": "string",
      "minLength": 7,
      "maxLength": 20,
      "pattern": "^\\+?[0-9 ()-]+$"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "area": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12
        },
        "formattedAddress": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        }
      },
      "required": [
        "line1",
        "area",
        "city",
        "state",
        "postalCode",
        "formattedAddress"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "placeId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "quick",
          "interior",
          "complete",
          "premium"
        ]
      }
    },
    "coverImageUrl": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "category": {
            "enum": [
              "quick",
              "interior",
              "complete",
              "premium"
            ]
          },
          "priceMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1440
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "category",
          "priceMinor",
          "durationMinutes"
        ]
      }
    },
    "availability": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "slots": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "startAt": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "endAt": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "startAt",
                "endAt",
                "capacity"
              ]
            }
          }
        },
        "required": [
          "date",
          "slots"
        ]
      }
    }
  },
  "required": [
    "name",
    "contactPhone",
    "address",
    "location",
    "categories",
    "services",
    "availability"
  ]
}
