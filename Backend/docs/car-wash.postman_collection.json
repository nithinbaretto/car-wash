    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Onboard",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/me/onboarding",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Test Customer\",\n  \"initialRole\": \"customer\",\n  \"acceptedTermsVersion\": \"v1\",\n  \"acceptedPrivacyVersion\": \"v1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "header": [
          {
