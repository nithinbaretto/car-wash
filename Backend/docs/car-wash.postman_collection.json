{
  "info": {
    "name": "Car Wash API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local environment by default. Execute requests individually; mutations affect data. Tokens and IDs must be supplied. See API_CURL.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5002/car-wash-5d9ce/asia-south1/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "shopId",
      "value": "REPLACE"
    },
    {
      "key": "serviceId",
      "value": "REPLACE"
    },
    {
      "key": "bookingId",
      "value": "REPLACE"
    },
    {
      "key": "userId",
      "value": "REPLACE"
    },
    {
      "key": "date",
      "value": "REPLACE_WITH_FUTURE_YYYY-MM-DD"
    },
    {
      "key": "idempotencyKey",
      "value": "REPLACE_WITH_UNIQUE_REQUEST_ID"
    }
  ],
